# ---------------------------------------------------------------------------
# Copie para .env  (raiz)  e preencha. Nunca commite o .env real.
# `supabase start` imprime as chaves locais no terminal.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=cole-a-anon-key-aqui
# SERVICE ROLE: somente backend. Ignora RLS. Jamais exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_STORAGE_BUCKET=rating-reports

# --- Projeto remoto (producao) --------------------------------------------
SUPABASE_PROJECT_REF=
# Pooler transaction mode (IPv4) - runtime da aplicacao
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Pooler session mode - usado pelas migrations
DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- API (NestJS) ---------------------------------------------------------
API_PORT=3333
API_PREFIX=api
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Rate limit (janela em segundos / requisicoes por janela)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Seed dos 2 usuarios master ------------------------------------------
# Usado por `pnpm --filter @rating-pro/api seed:masters`
MASTER_1_EMAIL=master1@ratingpro.com.br
MASTER_1_PASSWORD=TroqueEssaSenha!123
MASTER_1_NAME=Master Um
MASTER_2_EMAIL=master2@ratingpro.com.br
MASTER_2_PASSWORD=TroqueEssaSenha!456
MASTER_2_NAME=Master Dois

# --- Contratacao de rating (fluxo de 4 etapas) ----------------------------
# Onde os anexos dos pedidos sao gravados. Precisa ser volume persistente.
UPLOADS_DIR=./uploads
# 32 bytes em base64. Cifra a senha do Serasa (AES-256-GCM). Perder a chave
# torna as credenciais ja gravadas ilegiveis.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
# Preco de tabela, em reais.
RATING_PRICE_PF=0
RATING_PRICE_PJ=0
# Chave PIX mostrada na etapa de pagamento (vazio esconde a instrucao).
# So vale quando a integracao Asaas esta desligada.
PIX_KEY=

# --- Asaas (cobranca com split entre os socios) ---------------------------
# Chave de API (Menu > Integracoes > Chave de API). Vazio desliga a
# integracao e a cobranca volta a ser manual (PIX_KEY + baixa pelo master).
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
# Token combinado no cadastro do webhook (painel Asaas > Integracoes >
# Webhooks). Obrigatorio quando ASAAS_API_KEY esta definida.
ASAAS_WEBHOOK_TOKEN=
# Split de recebimento: "walletId:percentual[:Nome]" separado por virgula.
# Ex.: 70% para um socio e 30% para o outro:
#   ASAAS_SPLIT_WALLETS=carteira-socio-1:70:Ana,carteira-socio-2:30:Bruno
# O walletId de cada socio fica em Menu > Integracoes > Carteira, na conta
# DELE. O que nao for listado fica na conta que emitiu a cobranca — se a
# conta principal ja e de um dos socios, liste so a carteira do outro. O nome
# e opcional e so aparece no painel dos socios.
ASAAS_SPLIT_WALLETS=
# Nome do socio dono da conta que emite as cobrancas: e ele quem recebe o que
# o split nao distribui, e o painel precisa chama-lo por um nome.
ASAAS_MAIN_ACCOUNT_NAME=Conta principal
# Vencimento das cobrancas, em dias corridos.
ASAAS_DUE_DAYS=3

# --- Frontend (Vite) ------------------------------------------------------
# Somente variaveis VITE_* chegam ao browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-a-anon-key-aqui
VITE_API_URL=http://localhost:3333/api
VITE_BRAND_NAME=Rating Pro
VITE_BRAND_SHORT=RatingPro
VITE_WHATSAPP_NUMBER=5511999999999
VITE_CONTACT_EMAIL=contato@ratingpro.com.br
