# ---------------------------------------------------------------------------
# Copie para .env  (raiz)  e preencha. Nunca commite o .env real.
# `supabase start` imprime as chaves locais no terminal.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=cole-a-anon-key-aqui
# SERVICE ROLE: somente backend. Ignora RLS. Jamais exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_STORAGE_BUCKET=rating-reports

# --- Projeto remoto (producao) --------------------------------------------
SUPABASE_PROJECT_REF=
# Pooler transaction mode (IPv4) - runtime da aplicacao
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Pooler session mode - usado pelas migrations
DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- API (NestJS) ---------------------------------------------------------
API_PORT=3333
API_PREFIX=api
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Rate limit (janela em segundos / requisicoes por janela)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Seed dos 2 usuarios master ------------------------------------------
# Usado por `pnpm --filter @rating-pro/api seed:masters`
MASTER_1_EMAIL=master1@ratingpro.com.br
MASTER_1_PASSWORD=TroqueEssaSenha!123
MASTER_1_NAME=Master Um
MASTER_2_EMAIL=master2@ratingpro.com.br
MASTER_2_PASSWORD=TroqueEssaSenha!456
MASTER_2_NAME=Master Dois

# --- Frontend (Vite) ------------------------------------------------------
# Somente variaveis VITE_* chegam ao browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole-a-anon-key-aqui
VITE_API_URL=http://localhost:3333/api
VITE_BRAND_NAME=Rating Pro
VITE_BRAND_SHORT=RatingPro
VITE_WHATSAPP_NUMBER=5511999999999
VITE_CONTACT_EMAIL=contato@ratingpro.com.br
