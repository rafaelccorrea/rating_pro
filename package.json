{
  "name": "rating-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node apps/api/dist/main.js",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @rating-pro/web dev",
    "dev:api": "pnpm --filter @rating-pro/api dev",
    "build": "pnpm --filter @rating-pro/shared build && pnpm --filter @rating-pro/api build && pnpm --filter @rating-pro/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.110.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "supabase"
    ]
  }
}
